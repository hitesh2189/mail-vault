# Copy to .env and fill in. NEVER commit .env or any real secret.
# Capacity plan: 4 users x 150 GB = 600 GB. See CONFIG_PLAN.md.
# Estimated AWS budget: USD 45-60/month before taxes; not an enforced cap.
WORKSPACE_DOMAIN=example.com

# --- Google OAuth (portal login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Service-account JSON with domain-wide delegation for gmail.readonly (+ gmail.modify only if you enable cleanup).
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json

# Portal session signing key. Generate: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=replace-with-at-least-32-random-characters

# --- Amazon S3 (private, versioned, encrypted bucket) ---
S3_BUCKET=company-mail-archive
AWS_DEFAULT_REGION=eu-west-1
# Optional SSE-KMS key id; leave blank for SSE-S3 (AES256).
S3_KMS_KEY_ID=
# On EC2 use an instance role; off-AWS/Lightsail, supply AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY via your secret manager.

DATABASE_PATH=/data/archive.sqlite
# Your trusted HTTPS origin. Secure cookies require HTTPS (HTTP localhost login is intentionally disabled).
PUBLIC_URL=https://archive.example.com

# --- Enrollment / access ---
# Explicit mailbox allowlist (used when OPEN_DOMAIN is false).
MAILBOXES=alice@example.com,bob@example.com
# Self-service: when true, ANY verified @WORKSPACE_DOMAIN user may sign in and back up/view their OWN mailbox
# (allowlist bypassed; domain + verified-email still enforced; users only ever act on their own mailbox).
OPEN_DOMAIN=false
# Auto-run a backup on login, but ONLY for users who have saved backup rules (no surprise full backups).
AUTO_SYNC_ON_LOGIN=false
# Optional cap on messages per login/targeted sync run (blank = no cap).
LOGIN_SYNC_MAX=

# Admin dashboard + cleanup. Admins can run cleanup and see cleanup-candidate metadata (not full content view of others).
ADMIN_EMAILS=admin@example.com

# Must remain false until a supervised pilot has validated backup + recovery. Cleanup moves Gmail messages to Trash.
ENABLE_CLEANUP=false
